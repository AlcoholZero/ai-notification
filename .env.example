# ============================================================
# AI通知小程序 - 环境变量配置
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env  →  cp .env.example .env
#   2. 按需修改配置
#   3. 启动 Docker Compose →  docker-compose up -d
# ============================================================

# ---- 模型选择（本地 Ollama 推荐配置） ----
# 文本提取模型：qwen2.5:7b（4GB显存）| qwen2.5:14b（8GB显存）| qwen2.5:3b（2GB显存）
LLM_MODEL=qwen2.5:7b
# 视觉识别模型（用于截图OCR）：qwen2.5-vl:7b | llama3.2-vision:11b
OCR_MODEL=qwen2.5-vl:7b

# ============================================================
# 以下配置通常无需修改，除非你想使用云端 API
# ============================================================

# ---- 方案 A：本地 Ollama（默认，零成本） ----
LLM_PROVIDER=openai
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
OCR_PROVIDER=openai_vision
OPENAI_API_KEY=ollama
OPENAI_VISION_MODEL=qwen2.5-vl:7b
ASR_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# ---- 方案 B：OpenAI 云端 API（取消注释并填入密钥） ----
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OCR_PROVIDER=openai_vision
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_VISION_MODEL=gpt-4o
# ASR_PROVIDER=openai_whisper
# EMBEDDING_PROVIDER=openai

# ---- 方案 C：通义千问/阿里云（取消注释并填入密钥） ----
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo
