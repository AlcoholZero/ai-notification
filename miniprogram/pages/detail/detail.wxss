/* detail.wxss - 通知详情页样式 */

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner-lg {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #E0E0E0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 主信息卡片 */
.detail-main-card {
  margin-top: 16rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 元信息行 */
.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999999;
}

.meta-time {
  margin-left: auto;
}

.meta-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #ffffff;
}

/* 内容区段 */
.section-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.detail-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.copy-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  background-color: #F0F7FF;
  color: #3B82F6;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.detail-raw-content {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.8;
  background-color: #F9FAFB;
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #E5E7EB;
  word-break: break-all;
}

/* 操作按钮 */
.detail-actions {
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.detail-actions .btn {
  width: 100%;
}
