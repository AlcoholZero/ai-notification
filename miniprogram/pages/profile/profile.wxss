/* profile.wxss - 个人中心页样式 */

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #E0E7FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999999;
}

/* 统计信息卡片 */
.stats-card {
  display: flex;
  align-items: center;
  padding: 36rpx 24rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #3B82F6;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EEEEEE;
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-add {
  font-size: 26rpx;
  color: #3B82F6;
}

/* 项目标签列表 */
.project-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.project-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #F5F5F5;
  border-radius: 32rpx;
}

.project-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.project-name {
  font-size: 26rpx;
  color: #555555;
}

.empty-project {
  padding: 20rpx 0;
  text-align: center;
}

.empty-project-text {
  font-size: 26rpx;
  color: #CCCCCC;
}

/* 功能菜单 */
.menu-card {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  transition: background-color 0.2s;
}

.menu-item:active {
  background-color: #F5F5F5;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

.menu-divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin-left: 88rpx;
}

/* 新建项目弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-content {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 36rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-placeholder {
  color: #CCCCCC;
}

/* 颜色选择列表 */
.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  border: 4rpx solid transparent;
}

.color-item.selected {
  border-color: #333333;
  transform: scale(1.1);
}

.color-check {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

/* 弹窗按钮 */
.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.modal-btn {
  flex: 1;
}
