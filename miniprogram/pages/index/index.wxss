/* index.wxss - 首页样式 */

/* 顶部标题区 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #999999;
}

/* 输入入口区域 */
.input-section {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.input-card {
  width: 48%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 0;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.input-card:active {
  transform: scale(0.96);
  background-color: #F0F7FF;
}

.input-card.recording {
  background-color: #FEF2F2;
  border: 2rpx solid #EF4444;
}

.input-card-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.input-card-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.input-card-desc {
  font-size: 22rpx;
  color: #AAAAAA;
}

/* 录音提示 */
.recording-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.recording-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
}

.wave-bar {
  width: 8rpx;
  height: 40rpx;
  background-color: #3B82F6;
  border-radius: 4rpx;
  animation: wave 0.8s infinite ease-in-out;
}

.wave-bar:nth-child(1) { animation-delay: 0s; }
.wave-bar:nth-child(2) { animation-delay: 0.15s; }
.wave-bar:nth-child(3) { animation-delay: 0.3s; }
.wave-bar:nth-child(4) { animation-delay: 0.45s; }
.wave-bar:nth-child(5) { animation-delay: 0.6s; }

@keyframes wave {
  0%, 100% { height: 20rpx; }
  50% { height: 56rpx; }
}

.recording-text {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.stop-btn {
  padding: 12rpx 48rpx;
  background-color: #EF4444;
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 处理中遮罩 */
.processing-overlay {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.processing-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 旋转加载动画 */
.processing-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E0E0E0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 28rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.processing-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.processing-subtext {
  font-size: 24rpx;
  color: #999999;
}

/* 处理结果卡片 */
.result-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #10B981;
}

.result-close {
  font-size: 36rpx;
  color: #CCCCCC;
  padding: 8rpx;
}

.result-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.result-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.result-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.result-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.result-actions {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
}

.result-actions .btn {
  width: 100%;
}

/* 最近通知区域 */
.recent-section {
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-more {
  font-size: 26rpx;
  color: #3B82F6;
}

/* 文字输入弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-content {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.modal-placeholder {
  color: #CCCCCC;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
}
